# Keitaro Admin API (учебный эмулятор). Ключ — в шапке эмулятора или в Keitaro: Профиль → API ключи.
KEITARO_API_URL=https://keitaro-for-tests.etolegko.com/admin_api/v1
KEITARO_API_KEY=

# База: по умолчанию SQLite-файл keitaro_wrapper.db в корне проекта.
# Для PostgreSQL: postgresql+asyncpg://wrapper:wrapper@localhost:5432/wrapper
# DATABASE_URL=sqlite+aiosqlite:///./keitaro_wrapper.db

# Префикс имён кампаний в создаваторе и защита от публикации в чужие кампании.
CAMPAIGN_NAME_PREFIX=test_lebedev_
WRITE_ALLOWED_PREFIX=test_lebedev_

# Значения по умолчанию для настроек кампании (имя или id). Пусто — первый доступный.
DEFAULT_DOMAIN=
DEFAULT_GROUP=FORTESTS
DEFAULT_TRAFFIC_SOURCE=FORTESTS

# KEITARO_TIMEOUT_SECONDS=10
# KEITARO_MAX_RETRIES=3
# OFFERS_CACHE_TTL_SECONDS=300
